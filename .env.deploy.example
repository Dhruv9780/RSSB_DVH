# Backend database (SQLite in Docker volume)
DATABASE_URL=file:./prod.db

# Must be long and random
JWT_ACCESS_SECRET=replace-with-a-strong-secret-at-least-24-characters
JWT_ACCESS_EXPIRES_IN=8h

# Initial super admin bootstrap values
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_FULL_NAME=Super Admin
BOOTSTRAP_ADMIN_PHONE=

# Public backend URL that browser can reach
# Example: http://192.168.1.119:4000/api/v1
FRONTEND_API_BASE_URL=http://localhost:4000/api/v1
