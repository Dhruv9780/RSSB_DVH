NODE_ENV=development
PORT=4000
# Supabase/Neon/Postgres connection string
DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?schema=public"
JWT_ACCESS_SECRET="replace-with-strong-secret"
JWT_ACCESS_EXPIRES_IN="8h"

# Optional: set false on Vercel if you move media to cloud storage.
ENABLE_LOCAL_UPLOADS="false"

# Initial super admin bootstrap values
BOOTSTRAP_ADMIN_USERNAME="superadmin"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"
BOOTSTRAP_ADMIN_FULL_NAME="Super Admin"
BOOTSTRAP_ADMIN_PHONE=""
